run = "pip install -q -r requirements.txt && python main.py"
entrypoint = "main.py"

[nix]
channel = "stable-23_11"

[env]
PYTHONUNBUFFERED = "1"

[packager]
language = "python3"

[packager.features]
enabledForHosting = true
packageSearch = true
guessImports = true

[languages.python3]
pattern = "**/*.py"

[deployment]
run = ["sh", "-c", "pip install -r requirements.txt && python main.py"]
deploymentTarget = "cloudrun"
